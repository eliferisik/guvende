rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;

      match /trustedContacts/{contactId} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
      }

      match /safeZones/{zoneId} {
        function isOwner() {
          return request.auth != null && request.auth.uid == userId;
        }

        allow read, delete: if isOwner();
        allow create: if isOwner()
          && request.resource.data.keys().hasOnly([
            'name', 'address', 'latitude', 'longitude', 'createdAt'
          ])
          && request.resource.data.keys().hasAll([
            'name', 'address', 'latitude', 'longitude', 'createdAt'
          ])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80
          && request.resource.data.address is string
          && request.resource.data.address.size() <= 500
          && request.resource.data.latitude is number
          && request.resource.data.latitude >= -90
          && request.resource.data.latitude <= 90
          && request.resource.data.longitude is number
          && request.resource.data.longitude >= -180
          && request.resource.data.longitude <= 180
          && request.resource.data.createdAt == request.time;
        allow update: if isOwner()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'address'
          ])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80
          && request.resource.data.address is string
          && request.resource.data.address.size() <= 500;
      }

      match /sosAlerts/{alertId} {
        function isOwner() {
          return request.auth != null && request.auth.uid == userId;
        }

        allow create: if isOwner()
          && request.resource.data.keys().hasOnly([
            'status', 'latitude', 'longitude', 'mapUrl', 'createdAt'
          ])
          && request.resource.data.keys().hasAll([
            'status', 'latitude', 'longitude', 'mapUrl', 'createdAt'
          ])
          && request.resource.data.status == 'active'
          && request.resource.data.latitude is number
          && request.resource.data.latitude >= -90
          && request.resource.data.latitude <= 90
          && request.resource.data.longitude is number
          && request.resource.data.longitude >= -180
          && request.resource.data.longitude <= 180
          && request.resource.data.mapUrl is string
          && request.resource.data.createdAt == request.time;

        allow update: if isOwner()
          && resource.data.status == 'active'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'cancelledAt'
          ])
          && request.resource.data.diff(resource.data).affectedKeys().hasAll([
            'status', 'cancelledAt'
          ])
          && request.resource.data.status == 'cancelled'
          && request.resource.data.cancelledAt == request.time;
      }
    }
  }
}
